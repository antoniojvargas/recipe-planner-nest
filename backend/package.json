    "jose": "^6.2.17",
    "mongoose": "^9.12.1",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",

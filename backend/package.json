    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mongoose": "^12.0.1",
    "@nestjs/observe": "^0.3.0",
    "@nestjs/platform-fastify": "^12.5.0",
    "@nestjs/terminus": "^12.1.0",
    "@recipe-planner/contracts": "0.1.0",
    "argon2": "^0.45.2",
    "bullmq": "^6.7.6",

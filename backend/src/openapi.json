{
  "openapi": "3.0.0",
  "info": {
    "title": "Recipe Planner API",
    "description": "API para el planificador de recetas",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor de la API"
    }
  ],
  "paths": {},
  "components": {
    "schemas": {},
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token"
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "cookie": []
    },
    {
      "bearerAuth": []
    }
  ]
}

# Copia este fichero a `.env` (`cp .env.example .env`) y cambia los secretos.
#
# `docker compose` lee `.env` para las variables obligatorias del compose
# (S3_ACCESS_KEY, S3_SECRET_KEY, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET) y para el resto.
# Los valores de URLs de aquí apuntan a los nombres de servicio de la red de Docker;
# si ejecutas la API en el host sin contenedores, sustitúyelos por `localhost`
# (y los puertos publicados: 27017, 6379, 9000).

# --- Base de datos y caché ---
# El replica set `rs0` es de un solo nodo y lo inicializa el healthcheck de `mongo`.
MONGO_URL=mongodb://mongo:27017/recipes?replicaSet=rs0
REDIS_URL=redis://redis:6379

# --- Almacenamiento de objetos (MinIO / S3) ---
# S3_ENDPOINT: por donde la API y el worker hablan con MinIO dentro de la red privada
#   de Docker. Es el nombre del servicio y no sale del host; sirve para subir,
#   comprobar con HeadObject y borrar objetos.
S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT: el host que se firma dentro de las URLs prefirmadas que abre el
#   navegador (`http://localhost:9000` en desarrollo, el dominio de `media` en
#   producción). El navegador no resuelve `minio`, así que la URL que se le entrega
#   debe llevar este host, y la firma se calcula sobre esa URL exacta: por eso no basta
#   con reescribir el host después. La API usa S3_ENDPOINT para el tráfico interno y
#   S3_PUBLIC_ENDPOINT solo para firmar.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=recipes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Tokens de sesión ---
# Mínimo 32 caracteres cada uno y distintos entre sí. Genera uno con:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# --- Correo ---
# Mailpit en desarrollo: la interfaz web está en http://localhost:8025.
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM=Recipe Planner <no-reply@recipe-planner.local>

# --- Aplicación ---
# `development` en local, `test` para la pila E2E y `production` en el despliegue.
APP_ENV=development
# `debug`, `info`, `warn` o `error` (pino, fase 2).
LOG_LEVEL=debug
# Origen exacto permitido por CORS y por los enlaces de los correos.
FRONTEND_URL=http://localhost:3001
# Cómo llega el frontend a la API desde dentro de la red de Docker. Los Server
# Components lo usan para cargar datos sin pasar por el navegador.
API_INTERNAL_URL=http://backend:3000

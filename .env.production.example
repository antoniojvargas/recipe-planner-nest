# Variables NO secretas de la pila de producción (`docker-compose.prod.yml`).
#
#   cp .env.production.example .env
#   # crea los 8 ficheros de secrets/*.txt que se listan en secrets/README.md
#   docker compose -f docker-compose.prod.yml up -d --build --wait
#
# Aquí NO hay contraseñas ni tokens: Mongo, Redis, MinIO y los secretos JWT llegan como
# Docker secrets y la API los lee mediante sus variantes `*_FILE`. Las variables que sí
# faltan en este fichero son obligatorias y `docker compose` avisará si no están.

# --- Dominio y TLS ---
# Host que sirve Caddy con su CA interna (`tls internal`). Para probar en local, añádelo
# a /etc/hosts apuntando a 127.0.0.1 y confía en la CA de Caddy:
#   docker compose -f docker-compose.prod.yml cp caddy:/data/caddy/pki/authorities/local/root.crt caddy-root.crt
APP_DOMAIN=recipes.local

# --- Proxy inverso ---
# Red desde la que se acepta X-Forwarded-For. Por defecto, el rango de los bridges de
# Docker donde Caddy se conecta a la API. Si tu compose usa otra subred, cámbialo aquí:
# TRUST_PROXY=172.16.0.0/12

# --- Mongo ---
# Nombre del usuario root; su contraseña vive en secrets/mongo_root_password.txt.
MONGO_ROOT_USERNAME=recipes

# --- Correo ---
# Por defecto apunta al Mailpit interno (sin puertos publicados). En un despliegue real,
# pon aquí el SMTP de tu proveedor y quita el servicio `mailpit` del compose.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# MAIL_FROM=Recipe Planner <no-reply@example.com>

# --- Logs ---
# debug, info, warn o error
# LOG_LEVEL=info

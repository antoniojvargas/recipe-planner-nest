# Variables de la pila de producción (`docker-compose.prod.yml`).
#
#   cp .env.production.example .env
#   docker compose -f docker-compose.prod.yml up -d --build --wait
#
# Cambia todos los secretos antes de desplegar. Los obligatorios no tienen valor por
# defecto: si falta alguno, `docker compose` se para al leer el fichero.

# --- Dominio y TLS ---
# Host que sirve Caddy con su CA interna (`tls internal`). Para probar en local, añádelo
# a /etc/hosts apuntando a 127.0.0.1 y confía en la CA de Caddy:
#   docker compose -f docker-compose.prod.yml cp caddy:/data/caddy/pki/authorities/local/root.crt caddy-root.crt
APP_DOMAIN=recipes.local

# --- Mongo ---
# Usuario root de Mongo y base `recipes` detrás de autenticación. La contraseña no puede
# llevar caracteres reservados de URL (`@`, `:`, `/`, `?`, `#`): va dentro de MONGO_URL.
# Genera con: openssl rand -base64 32 | tr -d '/+=' | head -c 32
MONGO_ROOT_USERNAME=recipes
MONGO_ROOT_PASSWORD=

# --- Redis ---
# BullMQ y el adaptador de Socket.IO comparten esta instancia.
REDIS_PASSWORD=

# --- MinIO (S3) ---
# Credenciales del usuario root de MinIO y del cliente de la API. El bucket `media` se crea
# al arrancar y queda privado: su nombre encaja con la ruta /media que publica Caddy.
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Tokens de sesión ---
# Mínimo 32 caracteres cada uno y distintos entre sí:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# --- Correo ---
# Por defecto apunta al Mailpit interno (sin puertos publicados). En un despliegue real,
# pon aquí el SMTP de tu proveedor y quita el servicio `mailpit` del compose.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# MAIL_FROM=Recipe Planner <no-reply@example.com>

# --- Logs ---
# debug, info, warn o error
# LOG_LEVEL=info
